<?xml version="1.0"?>

<ruleset name="percolate"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        percolate-local composition over the shared joke-strict ruleset. Gradle's ruleSets cannot subtract,
        so anything percolate re-enables or re-configures has to live here.
    </description>

    <rule ref="rulesets/java/joke-strict.xml"/>

    <!--
        joke-strict excludes TooManyMethods. Percolate re-enables it as the co-enforcer of the no-private
        rule: without a size ceiling, "no private methods" is satisfied by exposing a monolith's guts as
        package-private members. The threshold is a ratchet measured from the largest legitimate class in
        the repository, not a round number: ResolveCtx, the deliberate type-query seam, counts 22 (the rule
        does not count accessors). MapperGraph is next at 21. Lower this when either shrinks; never raise it.
    -->
    <rule ref="category/java/design.xml/TooManyMethods">
        <properties>
            <property name="maxmethods" value="22"/>
        </properties>
    </rule>

</ruleset>
